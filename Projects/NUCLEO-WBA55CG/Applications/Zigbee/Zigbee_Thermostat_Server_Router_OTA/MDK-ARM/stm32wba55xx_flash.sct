; *************************************************************
; *** Scatter-Loading Description File                      ***
; *************************************************************

; Startup on Flash : 0x08006000 to 0x08006400
LR_IROM1 0x08006000 0x400 {
  ER_IROM1 0x08006000 0x400 {
    *.o (RESET, +First)
    *(InRoot$$Sections)
  }
}

; OTA info on Flash : 0x08006400 to 0x08006500
LR_IROM2 0x08006400 0x100 {
  ER_IROM2 0x08006400 0x100 {
    *.o (TAG_OTA_INFO)
  }
}

; Application on Flash : 0x08006500 to 0x08080000
LR_IROM3 0x08006500 (0x80000 - 0x6500) {
  ER_IROM3 0x08006500 (0x80000 - 0x6500) {
    .ANY (+RO)
    *.o (TAG_OTA_END, +Last)
  }

  RW_IRAM1 0x20000000 0x00020000 {
    .ANY (+RW +ZI)
  }
}

; Download zone on Flash : 0x08080000 to 0x080FC000
; NVM zone on Flash      : 0x080FC000 to 0x08100000
